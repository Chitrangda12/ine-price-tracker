# Supabase → Project Settings → Database → Connection string (URI).
# Use the "Session pooler" string; it works on IPv4 networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

PORT=4000

# Frontend origin(s) allowed to call the API (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Shared secret the external cron sends in the X-Cron-Secret header.
CRON_SECRET=change-me-to-a-long-random-string

STORE_URL=https://demo.inelabteamdev.com

# Set to false to watch the browser while it scrapes.
HEADLESS=true

# Optional tuning (defaults shown).
# SCRAPE_MAX_TRIES=3
# SCRAPE_NAV_TIMEOUT_MS=30000
# SCRAPE_RENDER_TIMEOUT_MS=20000
# SCRAPE_QUOTE_TIMEOUT_MS=45000
# SCRAPE_MIN_INTERVAL_MINUTES=100

# Optional: save a screenshot here whenever a scrape try fails (local debugging).
# SCRAPE_DEBUG_DIR=debug
